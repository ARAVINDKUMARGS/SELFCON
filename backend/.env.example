PORT=5000
NODE_ENV=development
# MongoDB connection - uses MongoMemoryServer automatically if local MongoDB is absent
MONGODB_URI=mongodb://127.0.0.1:27017/selfcon
USE_MEMORY_DB=false

# Authentication
JWT_SECRET=selfcon_super_secret_jwt_key_2026_redefined
JWT_EXPIRES_IN=7d

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Cloudinary (Optional - local fallback provided)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay (India) & Stripe (Optional)
RAZORPAY_KEY_ID=rzp_test_selfcon12345
RAZORPAY_KEY_SECRET=rzp_secret_selfcon12345
STRIPE_SECRET_KEY=sk_test_selfcon_optional

# Frontend Origin
CLIENT_URL=http://localhost:5173

